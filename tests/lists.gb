' typed lists: ordering, removal while iterating, value lists
strict
type t_a
    field n:int
endtype

function make_a:t_a(n:int)
    local a:t_a = new t_a
    a.n = n
    return a
endfunction

function dump(l:list<t_a>)
    local out:string = ""
    for local a:t_a = eachin l
        out :+ a.n + " "
    next
    print("[" + trim(out) + "] count=" + count(l))
endfunction

local l:list<t_a> = new list<t_a>
for local i:int = 1 to 6
    add_last(l, make_a(i))
next
add_first(l, make_a(0))
dump(l)

' removing the current element inside eachin is safe
for local a:t_a = eachin l
    if a.n mod 2 = 1 then remove(l, a) endif
next
dump(l)

' removing an element ahead of the loop skips it
local four:t_a
for local a:t_a = eachin l
    if a.n = 4 then four = a endif
next
for local a:t_a = eachin l
    write(a.n + " ")
    if a.n = 2 then remove(l, four) endif
next
print("")
print("contains four: " + contains(l, four))

' clear while iterating ends the loop cleanly
local seen:int = 0
for local a:t_a = eachin l
    seen :+ 1
    clear(l)
next
print("seen=" + seen + " empty=" + is_empty(l))

' lists of values; remove and contains compare by value
local q:list<int> = new list<int>
add_first(q, 10)
add_last(q, 20)
add_last(q, 30)
add_last(q, 20)
remove(q, 20)          ' removes the first 20 only
local s:string = ""
for local n:int = eachin q : s :+ n + " " : next
print("ints: " + s + "contains 20: " + contains(q, 20))

local f:list<float> = new list<float>
add_last(f, 1)         ' an int is fine in a float list
add_last(f, 2.5)
s = ""
for local x:float = eachin f : s :+ x + " " : next
print("floats: " + s)

local words:list<string> = new list<string>
add_last(words, "goober")
add_last(words, "")    ' the empty string is a value too
add_last(words, "basic")
remove(words, "goober")
s = ""
for local w:string = eachin words : s :+ "[" + w + "]" : next
print("strings: " + s + " count=" + count(words))

' a list in a field, and an array of lists
type t_bag
    field items:list<string>
endtype
local bag:t_bag = new t_bag
bag.items = new list<string>
add_last(bag.items, "key")
print("bag: " + count(bag.items))
local rows:list<int>[2]
rows[1] = new list<int>
add_last(rows[1], 5)
print("rows[1]: " + count(rows[1]))


' first / last / remove_first / remove_last give back the element's own type
local d:list<int> = new list<int>
for local i:int = 1 to 5 : add_last(d, i * 10) : next
print("first=" + first(d) + " last=" + last(d))
local took:int = remove_first(d) + remove_last(d)
print("took=" + took + " count=" + count(d))
local m:list<t_a> = new list<t_a>
add_last(m, make_a(7))
print("first .n=" + first(m).n)

' positions count from 1; 0 means not there
print("contains 30: " + contains(d, 30) + " contains 99: " + contains(d, 99))
print("remove 30: " + remove(d, 30) + " remove 99: " + remove(d, 99))

' insert clamps: below 1 goes first, past the end goes last
local p:list<string> = new list<string>
insert(p, 1, "b")       ' into an empty list
insert(p, -5, "a")
insert(p, 99, "d")
insert(p, 3, "c")       ' becomes item 3
insert(p, 2.6, "x")     ' a float position is cut to a whole number, like int()
s = ""
for local w:string = eachin p : s :+ w : next
print("insert: " + s + " count=" + count(p))

' count(list, value) counts the matching items: by value, or the same object
local c:list<int> = new list<int>
add_last(c, 2) : add_last(c, 5) : add_last(c, 2) : add_last(c, 2)
local cw:list<string> = new list<string>
add_last(cw, "a") : add_last(cw, "b") : add_last(cw, "a")
print("count 2s: " + count(c, 2) + " 9s: " + count(c, 9) + " all: " + count(c) + " a: " + count(cw, "a"))
local seven:t_a = first(m)
add_last(m, make_a(7))      ' another 7, but a different object
print("count same object: " + count(m, seven) + " of " + count(m))

' a variable may still be called count, first or last
local count:int = 3
local last:string = "z"
print("vars: " + count + last + " list count=" + count(p))

' list<...> syntax: a '>' right before '=' still closes the type, function
' types go inside, a function can return a list, and list is still a usable name
local tight:list<int>= new list<int>()
add_last(tight, 1)
local ops:list<int(int)> = new list<int(int)>
add_last(ops, function:int(n:int)
    return n + 100
endfunction)
function evens:list<int>(upto:int)
    local r:list<int> = new list<int>
    for local i:int = 2 to upto step 2 : add_last(r, i) : next
    return r
endfunction
local list:int = 5
if list >= 5 and list<=5 then print("syntax: " + first(tight) + " " + first(ops)(1) + " " + count(evens(9))) endif

local nothing:list<t_a>
for local a:t_a = eachin nothing
next
