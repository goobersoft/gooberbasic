' Sized integer types, 64-bit integers, and float (32-bit) vs double (64-bit).
strict

' ---- wrapping on store ----
local b:byte = 250
b :+ 10
print("byte 250+10 = " + b)
local b2:uint8 = -1
print("uint8 -1 = " + b2)
local sb:sint8 = 127
sb :+ 1
print("sint8 127+1 = " + sb)
local sh:short = 65535
sh :+ 1
print("short 65535+1 = " + sh)
local ss:sint16 = -32768
ss :- 1
print("sint16 -32768-1 = " + ss)
local s32:sint32 = 2147483647
s32 :+ 1
print("sint32 max+1 = " + s32)
local u32:uint32 = 4294967295
print("uint32 max = " + u32)
u32 :+ 1
print("uint32 max+1 = " + u32)
local u32b:uint32 = -1
print("uint32 -1 = " + u32b)

' ---- arithmetic happens at full width, wrapping only on store ----
local x:byte = 200, y:byte = 100
print("byte 200+100 as an expression = " + (x + y))
print("-byte = " + (-x))

' ---- 64-bit ----
local big:sint64 = 9223372036854775807
print("sint64 max = " + big)
big :+ 1
print("sint64 max+1 = " + big)
local lo:sint64 = -9223372036854775808
print("sint64 min = " + lo)
local ul:long = 18446744073709551615
print("long max = " + ul)
ul :+ 1
print("long max+1 = " + ul)
local u64:uint64 = -1
print("uint64 -1 = " + u64)
print("uint64 / 2 = " + (u64 / 2))
print("uint64 mod 10 = " + (u64 mod 10))
print("uint64 > 0 = " + (u64 > 0))
local neg:sint64 = -7
print("sint64 -7 / 2 = " + (neg / 2) + ", mod 2 = " + (neg mod 2))
print("int * int overflow (int) = " + (65536 * 65536))
local w:sint64 = 65536
print("sint64 65536 * 65536 = " + (w * 65536))
print("2^40 via shl = " + (w shl 24))
print("long literal = " + 5000000000)
print("hex 64-bit = " + $FFFFFFFFFF)
print("hex 32-bit stays int = " + $FFFFFFFF)
print("sint64 & mask = " + ((big - 1) & $FF))
print("bitwise not of sint64 65536 = " + (~w))
print("long sar 1 = " + (u64 sar 1) + ", shr 1 = " + (u64 shr 1))
print("mixed int + long = " + (1 + ul + 5))

' ---- float is 32-bit, double is 64-bit ----
local f:float = 0.1
local d:double = 0.1
print("float 0.1 = " + f + ", double 0.1 = " + d)
print("float = 0.1 literal: " + (f = 0.1))
print("double(float 0.1) = 0.1: " + (double(f) = 0.1))
local f3:float = 16777216
f3 :+ 1
print("float 16777216+1 = " + f3)
local d3:double = 16777216
d3 :+ 1
print("double 16777216+1 = " + d3)
local third:float = 1.0 / 3
print("float 1/3 * 3 = " + (third * 3))
print("float*double = " + (f * d))
local fd:double = f
print("double from float 0.1 *1e9 = " + int(fd * 1000000000))
local z# = 0.5
z# = z# * 3
print("suffix # is float: " + z#)

' ---- conversions ----
print("byte(300) = " + byte(300))
print("sint8(200) = " + sint8(200))
print("short(-1) = " + short(-1))
print("uint32(-2) = " + uint32(-2))
print("sint64(3.9) = " + sint64(3.9))
print("long(-5.0) = " + long(-5.0))
print("int(long max) = " + int(ul - 1))
print("double(2) / 3 = " + (double(2) / 3))
print("float(2) / 3 = " + (float(2) / 3))
local ls:sint64 = "-123456789012"
print("string -> sint64 = " + ls)
local lu:long = "18446744073709551615"
print("string -> long = " + lu)
local bs:byte = "258"
print("string -> byte = " + bs)

' ---- abs / sgn / min / max ----
local m8:sint8 = -128
print("abs(sint8 -128) = " + abs(m8))
print("abs(sint64 -7) = " + abs(neg) + ", sgn = " + sgn(neg))
print("min(long max, 3) = " + min(ul - 1, 3) + ", max = " + max(ul - 1, 3))
print("max(byte 4, -1) = " + max(b, -1))

' ---- loops, arrays, fields, lists ----
local total:sint64 = 0
for local i:sint64 = 4294967290 to 4294967300 step 5
    total :+ i
next
print("sint64 loop total = " + total)
local count:int = 0
for local k:byte = 250 to 0 step -50
    count :+ 1
next
print("byte loop ran " + count + " times")
local fl:float = 0
for local t:float = 0 to 1 step 0.25
    fl :+ t
next
print("float loop sum = " + fl)

local bytes:byte[3]
bytes[0] = 255 : bytes[1] = 256 : bytes[2] = -1
print("byte array = " + bytes[0] + " " + bytes[1] + " " + bytes[2])

type t_pixel
    field r:byte, g:byte, b:byte
    field id:long
endtype
local px:t_pixel = new t_pixel
px.r = 300
px.id = -1
print("field byte = " + px.r + ", field long = " + px.id)

local q:short list = new short list
add_last(q, 70000)
add_last(q, 5)
for local e:short = eachin q
    print("short list item " + e)
next
print("contains 4464: " + contains(q, 4464))

function half:sint64(v:sint64)
    return v / 2
endfunction
print("function sint64 = " + half(9000000000))

function to_byte:byte(v:int)
    return v
endfunction
print("function returning byte = " + to_byte(511))

const BIG_C = 10000000000
const SMALL_C:byte = 257
print("const long = " + (BIG_C * 2) + ", const byte = " + SMALL_C)

select ul - 1
    case 18446744073709551615
        print("select on long ok")
    default
        print("select on long FAILED")
endselect
