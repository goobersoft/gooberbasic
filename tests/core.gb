type t_player
  field name$
  field hp:int, x:float
endtype

players:t_player list = new t_player list
for n = 1 to 3
  p:t_player = new t_player
  p.name = "P" + n
  p.hp = n * 10
  add_last(players, p)
next
for p:t_player = eachin players
  if p.hp = 20 then remove(players, p)
next
for p = eachin players
  print(p.name + " hp=" + p.hp)
next

function add:int(a:int, b:int = 100)
  return a + b
endfunction
print(add(1, 2))
print(add(1))
print(fact(10))
function fact(n)
  if n <= 1 then return 1 else return n * fact(n - 1)
endfunction

local grid:int[3, 4]
grid[2, 3] = 42
print(grid[2, 3] + " len=" + len(grid) + "," + len(grid, 2))

select x
  case 1, 2 : print("small")
  case 5
    print("five")
  default
    print("other")
endselect

i = 0
while true
  i :+ 1
  if i > 100 then exit
wend
print("i=" + i)
repeat
  i = i - 30
until i < 0
print(i)
