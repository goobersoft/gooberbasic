' bounce.gb - bouncing balls. Click to add more, Esc to quit.
const WIDTH = 1200, HEIGHT = 720

type t_ball
    field x#, y#, dx#, dy#
    field r#
    field red, green, blue
endtype

global balls:t_ball list = new t_ball list

function add_ball(x#, y#)
    local b:t_ball = new t_ball
    b.x = x : b.y = y
    b.dx = rnd(-4, 4) : b.dy = rnd(-4, 4)
    b.r = rnd(8, 30)
    b.red = rand(80, 255) : b.green = rand(80, 255) : b.blue = rand(80, 255)
    list_add_last(balls, b)
endfunction

app_title("GooberBASIC - Bouncing Balls")
graphics(WIDTH, HEIGHT)
seed_rnd(millisecs())
set_cls_color(20, 20, 40)

for i = 1 to 1000
    add_ball(rnd(50, WIDTH - 50), rnd(50, HEIGHT - 50))
next

while not key_hit(KEY_ESCAPE)
    if mouse_hit(MOUSE_LEFT) then add_ball(mouse_x(), mouse_y())

    cls()
    for b:t_ball = eachin balls
        b.dy = b.dy + 0.15             ' gravity
        b.x = b.x + b.dx
        b.y = b.y + b.dy
        if b.x < b.r or b.x > WIDTH - b.r then b.dx = -b.dx : b.x = max(b.r, min(b.x, WIDTH - b.r))
        if b.y > HEIGHT - b.r then b.dy = -b.dy * 0.9 : b.y = HEIGHT - b.r
        set_color(b.red, b.green, b.blue)
        draw_circle(b.x, b.y, b.r)
    next

    set_color(255, 255, 255)
    draw_text("Balls: " + count_list(balls) + "   (click to add, Esc to quit)", 10, 10)
    flip()
wend
