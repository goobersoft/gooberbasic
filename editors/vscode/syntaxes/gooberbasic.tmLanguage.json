{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GooberBASIC",
  "scopeName": "source.gooberbasic",
  "fileTypes": [
    "gb"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#continuation"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.gooberbasic",
          "match": "'.*$"
        },
        {
          "name": "comment.block.rem.gooberbasic",
          "begin": "(?i)\\brem\\b",
          "end": "(?i)^\\s*end\\s*rem\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gooberbasic",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.gooberbasic",
              "match": "~[ntrq0~]"
            },
            {
              "name": "invalid.illegal.escape.gooberbasic",
              "match": "~."
            }
          ]
        }
      ]
    },
    "continuation": {
      "patterns": [
        {
          "match": "(\\.\\.)(.*)$",
          "captures": {
            "1": {
              "name": "punctuation.separator.continuation.gooberbasic"
            },
            "2": {
              "name": "comment.line.continuation.gooberbasic"
            }
          }
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "(?i)\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)([%#$])?",
          "captures": {
            "1": {
              "name": "storage.type.function.gooberbasic"
            },
            "2": {
              "name": "entity.name.function.gooberbasic"
            },
            "3": {
              "name": "storage.type.suffix.gooberbasic"
            }
          }
        },
        {
          "match": "(?i)\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.type.gooberbasic"
            },
            "2": {
              "name": "entity.name.type.gooberbasic"
            }
          }
        },
        {
          "match": "(?i)\\b(end\\s*(?:function|type))\\b",
          "captures": {
            "1": {
              "name": "storage.type.end.gooberbasic"
            }
          }
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "match": "(?i)(?<=[A-Za-z0-9_%#$])(:)(?:(list)\\s*(<)\\s*((?:double|sint16|sint32|sint64|string|uint16|uint32|uint64|float|short|sint8|uint8|byte|long|int|[A-Za-z_][A-Za-z0-9_]*))?|((?:double|sint16|sint32|sint64|string|uint16|uint32|uint64|float|short|sint8|uint8|byte|long|int|[A-Za-z_][A-Za-z0-9_]*)))(?![A-Za-z0-9_])",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.gooberbasic"
            },
            "2": {
              "name": "storage.type.list.gooberbasic"
            },
            "3": {
              "name": "punctuation.definition.list.gooberbasic"
            },
            "4": {
              "name": "storage.type.gooberbasic"
            },
            "5": {
              "name": "storage.type.gooberbasic"
            }
          }
        },
        {
          "match": "(?i)\\b(new)\\s+(?:(list)\\s*(<)\\s*((?:double|sint16|sint32|sint64|string|uint16|uint32|uint64|float|short|sint8|uint8|byte|long|int|[A-Za-z_][A-Za-z0-9_]*))?|((?:double|sint16|sint32|sint64|string|uint16|uint32|uint64|float|short|sint8|uint8|byte|long|int|[A-Za-z_][A-Za-z0-9_]*)))",
          "captures": {
            "1": {
              "name": "keyword.other.new.gooberbasic"
            },
            "2": {
              "name": "storage.type.list.gooberbasic"
            },
            "3": {
              "name": "punctuation.definition.list.gooberbasic"
            },
            "4": {
              "name": "storage.type.gooberbasic"
            },
            "5": {
              "name": "storage.type.gooberbasic"
            }
          }
        },
        {
          "match": "(?i)\\b(list)\\s*(<)\\s*((?:double|sint16|sint32|sint64|string|uint16|uint32|uint64|float|short|sint8|uint8|byte|long|int|[A-Za-z_][A-Za-z0-9_]*))",
          "captures": {
            "1": {
              "name": "storage.type.list.gooberbasic"
            },
            "2": {
              "name": "punctuation.definition.list.gooberbasic"
            },
            "3": {
              "name": "storage.type.gooberbasic"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gooberbasic",
          "match": "(?i)\\b(?:end\\s+(?:if|select|while)|else\\s+if)\\b"
        },
        {
          "name": "invalid.deprecated.gooberbasic",
          "match": "(?i)\\b(?:delete|each)\\b"
        },
        {
          "name": "keyword.control.gooberbasic",
          "match": "(?i)\\b(?:endselect|continue|endwhile|default|forever|eachin|elseif|repeat|return|select|endif|until|while|case|else|exit|next|step|then|wend|end|for|if|to)\\b"
        },
        {
          "name": "storage.modifier.gooberbasic",
          "match": "(?i)\\b(?:endfunction|superstrict|function|defdata|enddata|endtype|include|global|strict|const|field|local|type|dim|new)\\b"
        },
        {
          "name": "keyword.operator.word.gooberbasic",
          "match": "(?i)\\b(?:and|mod|not|sar|shl|shr|or)\\b"
        },
        {
          "name": "constant.language.gooberbasic",
          "match": "(?i)\\b(?:false|null|true|pi)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.gooberbasic",
          "match": "(?<![A-Za-z0-9_])\\$[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.gooberbasic",
          "match": "(?<![A-Za-z0-9_])%[01]+"
        },
        {
          "name": "constant.numeric.float.gooberbasic",
          "match": "(?<![A-Za-z0-9_])(?:\\d+\\.\\d*(?:[eE][+-]?\\d+)?|\\.\\d+(?:[eE][+-]?\\d+)?|\\d+[eE][+-]?\\d+)"
        },
        {
          "name": "constant.numeric.integer.gooberbasic",
          "match": "(?<![A-Za-z0-9_])\\d+"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.gooberbasic",
          "match": "(?i)\\b(?:string|abs|len|max|min|sgn|str)(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.gooberbasic",
          "match": "(?i)\\b(?:set_image_handle|channel_playing|draw_image_rect|graphics_height|save_screenshot|gc_mem_alloced|graphics_width|app_terminate|draw_image_ex|rects_overlap|repeat_string|runtime_error|set_cls_color|current_date|current_time|end_graphics|image_height|net_messages|remove_first|sound_volume|stop_channel|draw_circle|image_width|net_is_host|read_string|remove_last|text_height|data_count|draw_image|flush_keys|free_image|free_sound|gc_collect|hide_mouse|load_image|load_sound|mid_handle|mouse_down|move_mouse|net_status|net_update|play_music|play_sound|read_float|show_mouse|stop_music|text_width|add_first|app_title|draw_line|draw_oval|draw_rect|draw_text|load_font|millisecs|mouse_hit|net_close|net_error|net_peers|set_alpha|set_color|add_last|contains|distance|graphics|is_empty|key_down|net_from|net_host|net_join|net_peer|net_recv|net_send|read_int|seed_rnd|set_font|wait_key|key_hit|mouse_x|mouse_y|mouse_z|net_get|net_set|replace|restore|assert|insert|net_id|remove|atan2|clear|count|delay|first|floor|input|instr|log10|lower|print|right|round|upper|write|acos|asin|atan|ceil|flip|last|left|lset|plot|rand|rset|sqrt|trim|asc|bin|chr|cls|cos|exp|hex|log|mid|rnd|sin|sqr|tan)\\b(?![%#$])"
        },
        {
          "name": "storage.type.gooberbasic",
          "match": "(?i)\\b(?:double|sint16|sint32|sint64|string|uint16|uint32|uint64|float|short|sint8|uint8|byte|long|int)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "support.constant.gooberbasic",
          "match": "(?i)\\b(?:NET_MAX_PLAYERS|NET_CONNECTING|KEY_BACKSPACE|NET_CONNECTED|KEY_LCONTROL|KEY_PAGEDOWN|KEY_RCONTROL|MOUSE_MIDDLE|MOUSE_RIGHT|KEY_DELETE|KEY_EQUALS|KEY_ESCAPE|KEY_INSERT|KEY_LSHIFT|KEY_PAGEUP|KEY_PERIOD|KEY_RSHIFT|MOUSE_LEFT|KEY_COMMA|KEY_ENTER|KEY_MINUS|KEY_RIGHT|KEY_SLASH|KEY_SPACE|NET_SLOTS|KEY_DOWN|KEY_HOME|KEY_LALT|KEY_LEFT|KEY_RALT|NET_LOST|KEY_END|KEY_F10|KEY_F11|KEY_F12|KEY_TAB|NET_ALL|NET_OFF|NET_TCP|NET_UDP|KEY_F1|KEY_F2|KEY_F3|KEY_F4|KEY_F5|KEY_F6|KEY_F7|KEY_F8|KEY_F9|KEY_UP|KEY_0|KEY_1|KEY_2|KEY_3|KEY_4|KEY_5|KEY_6|KEY_7|KEY_8|KEY_9|KEY_A|KEY_B|KEY_C|KEY_D|KEY_E|KEY_F|KEY_G|KEY_H|KEY_I|KEY_J|KEY_K|KEY_L|KEY_M|KEY_N|KEY_O|KEY_P|KEY_Q|KEY_R|KEY_S|KEY_T|KEY_U|KEY_V|KEY_W|KEY_X|KEY_Y|KEY_Z)\\b"
        },
        {
          "name": "constant.other.gooberbasic",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)([%#$])?(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.gooberbasic"
            },
            "2": {
              "name": "storage.type.suffix.gooberbasic"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.gooberbasic"
            },
            "2": {
              "name": "variable.other.member.gooberbasic"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)([%#$])",
          "captures": {
            "1": {
              "name": "variable.other.gooberbasic"
            },
            "2": {
              "name": "storage.type.suffix.gooberbasic"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.gooberbasic",
          "match": ":[+\\-*/]"
        },
        {
          "name": "keyword.operator.comparison.gooberbasic",
          "match": "<>|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.gooberbasic",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.gooberbasic",
          "match": "[-+*/\\\\^]"
        },
        {
          "name": "keyword.operator.bitwise.gooberbasic",
          "match": "[&|~]"
        },
        {
          "name": "punctuation.separator.statement.gooberbasic",
          "match": "[:;]"
        },
        {
          "name": "punctuation.separator.comma.gooberbasic",
          "match": ","
        }
      ]
    }
  }
}
